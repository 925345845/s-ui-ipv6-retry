[Unit]
Description=IPv6 Retry independent agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
EnvironmentFile=/etc/default/s-ui-ipv6-retry-agent
Environment=SUI_AGENT_LOCAL_SOCKET=/run/s-ui-ipv6-retry/control.sock
ExecStart=/usr/local/s-ui-ipv6-retry/sui-agent
Restart=on-failure
RestartSec=5s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
