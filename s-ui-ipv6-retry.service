[Unit]
Description=IPv6 Retry independent pairing tool
Documentation=https://github.com/925345845/s-ui-ipv6-retry
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=/usr/local/s-ui-ipv6-retry
ExecStart=/usr/local/s-ui-ipv6-retry/sui
Environment=SUI_DB_FOLDER=/usr/local/s-ui-ipv6-retry/db
Environment=SUI_BIN_FOLDER=/usr/local/s-ui-ipv6-retry/bin
Environment=SUI_CONTROL_SOCKET=/run/s-ui-ipv6-retry/control.sock
Environment=SUI_DISABLE_XRAY=true
Environment=GOMEMLIMIT=400MiB
Environment=GOGC=50
RuntimeDirectory=s-ui-ipv6-retry
Restart=on-failure
RestartSec=10s
OOMScoreAdjust=800
LimitNOFILE=1048576
TimeoutStartSec=60
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
